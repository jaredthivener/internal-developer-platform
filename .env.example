# Copy to .env.local for local development. Values here are placeholders;
# never commit real ones. AKS deployments do not read this file: they take
# their secrets from Key Vault (see scripts/azure).

# NextAuth: generate with `openssl rand -base64 32`. Required in production.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Entra ID app registration used for sign-in.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Local development only: serve mock Crossplane/Azure data and skip sign-in.
# The AKS deploy script refuses to ship this setting.
# IDP_ALLOW_OFFLINE_K8S=true

# Desired-state store. The deploy script sets the blob values on AKS.
# IDP_DESIRED_STATE_AZURE_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net/
# IDP_DESIRED_STATE_AZURE_BLOB_CONTAINER=desired-state
# IDP_DESIRED_STATE_FILESYSTEM_PATH=/path/to/persistent/volume
